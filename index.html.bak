    <div id="form-dat-ve" class="booking-form-wrap" data-rv>
      <div class="form-header">
        <span class="kicker center">✦ Đặt Vé Giữ Chỗ Trực Tiếp ✦</span>
        <h3 class="form-title">Biểu Mẫu Đặt Vé Tàu Hà Nội 5 Cửa Ô</h3>
        <p class="form-sub">Điền thông tin bên dưới, dữ liệu sẽ tự động chuyển về Google Sheet quản lý và nhân viên chăm sóc khách hàng sẽ liên hệ xác nhận chuyến đi trong vòng 15 phút.</p>
      </div>

      <form id="bookingForm" class="booking-form" novalidate>
        <div class="form-grid">
          <!-- Họ và tên -->
          <div class="form-group">
            <label for="bfName">Họ và tên quý khách <span class="req">*</span></label>
            <input type="text" id="bfName" name="name" placeholder="Ví dụ: Nguyễn Văn An" required>
            <span class="form-err" id="errName">Vui lòng nhập họ và tên của bạn</span>
          </div>

          <!-- Số điện thoại -->
          <div class="form-group">
            <label for="bfPhone">Số điện thoại liên hệ <span class="req">*</span></label>
            <input type="tel" id="bfPhone" name="phone" placeholder="Ví dụ: 0912345678" required>
            <span class="form-err" id="errPhone">Vui lòng nhập số điện thoại hợp lệ</span>
          </div>

          <!-- Email -->
          <div class="form-group">
            <label for="bfEmail">Địa chỉ Email (để nhận xác nhận vé)</label>
            <input type="email" id="bfEmail" name="email" placeholder="Ví dụ: email@gmail.com">
          </div>

          <!-- Ngày đi -->
          <div class="form-group">
            <label for="bfDate">Ngày khởi hành mong muốn <span class="req">*</span></label>
            <input type="date" id="bfDate" name="date" required>
            <span class="form-err" id="errDate">Vui lòng chọn ngày đi</span>
          </div>

          <!-- Ca khởi hành -->
          <div class="form-group">
            <label for="bfShift">Ca khởi hành <span class="req">*</span></label>
            <select id="bfShift" name="shift" required>
              <option value="Ca Sáng (08:00 – 11:30)">🌅 Ca Sáng: 08:00 – 11:30</option>
              <option value="Ca Chiều (13:30 – 17:00)">🌇 Ca Chiều: 13:30 – 17:00</option>
            </select>
          </div>

          <!-- Hạng vé lựa chọn -->
          <div class="form-group">
            <label for="bfTicketType">Hạng vé mong muốn <span class="req">*</span></label>
            <select id="bfTicketType" name="ticketType" required>
              <option value="Vé Phổ Thông (459.000đ/người)">Phổ Thông — 459.000đ / người</option>
              <option value="Vé Premium (659.000đ/người)" selected>Premium — 659.000đ / người (Bán chạy)</option>
              <option value="Vé VIP (959.000đ/người)">Hạng VIP — 959.000đ / người</option>
            </select>
          </div>

          <!-- Số lượng vé -->
          <div class="form-group">
            <label for="bfQuantity">Số lượng khách / vé <span class="req">*</span></label>
            <input type="number" id="bfQuantity" name="quantity" min="1" max="60" value="2" required>
          </div>

          <!-- Ghi chú / Yêu cầu thêm -->
          <div class="form-group full-width">
            <label for="bfNote">Ghi chú hoặc yêu cầu đặc biệt (chọn vị trí ngồi, có trẻ em, ăn chay...)</label>
            <textarea id="bfNote" name="note" rows="3" placeholder="Nhập thêm mong muốn của quý khách nếu có..."></textarea>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-green btn-submit" id="btnSubmitForm">
            <span class="btn-text">🚂 GỬI YÊU CẦU ĐẶT VÉ (LƯU VÀO SHEET)</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
          <!-- // [LINK ĐẶT VÉ MỚI] -->
          <a class="btn btn-ghost sm js-book" href="https://booking.hanoitrain.vn/?refCode=quayve5cuao" target="_blank" rel="noopener">
            🟢 Hoặc đặt trực tiếp qua cổng vé điện tử
          </a>
        </div>
        <p class="form-footer-note">🔒 Thông tin khách hàng được bảo mật tuyệt đối và chỉ sử dụng cho mục đích giữ chỗ chuyến tàu.</p>
      </form>
    </div>
  </div>
</section>


